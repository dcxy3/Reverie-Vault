{
  "name": "reverie-vault",
  "version": "0.3.0",
  "private": true,
  "description": "A local game, light novel, manga and music library for Windows.",
  "main": "electron/main.cjs",
  "author": "Reverie Vault",
  "license": "MIT",
  "homepage": "https://github.com/KamiNeko-pre/gal-launcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamiNeko-pre/gal-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/KamiNeko-pre/gal-launcher/issues"
  },
  "keywords": [
    "galgame",
    "visual-novel",
    "launcher",
    "electron",
    "react",
    "windows",
    "game-library",
    "vndb",
    "bangumi"
  ],
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder --win dir",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "start": "cross-env NODE_ENV=production electron .",
    "preview": "vite preview --host 127.0.0.1"
  },
  "build": {
    "appId": "local.reverie-vault.app",
    "productName": "Reverie Vault",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "38.8.6",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/electron-icon.png",
      "ciallo.mp3",
      "package.json"
    ],
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Reverie Vault Portable ${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Reverie Vault Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reverie Vault"
    }
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "file:vendor/neteasecloudmusicapienhanced-api-4.30.1.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wait-on": "^9.0.1"
  }
}
